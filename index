// ── Utilities ─────────────────────────────────────────────────────
function $(id){ return document.getElementById(id); }

function fmt(n, currency, decimals=2){
  if(n==null||isNaN(n)) return '—';
  const sym=CURRENCY_SYMBOLS[currency]||(currency+' ');
  const sign=n<0?'-':'';
  const abs=Math.abs(n);
  if(abs>=1e6) return sign+sym+(abs/1e6).toFixed(2)+'M';
  if(abs>=1e3) return sign+sym+(abs/1e3).toFixed(1)+'K';
  return sign+sym+abs.toFixed(decimals);
}
function fmtPrice(n, currency){
  if(n==null||isNaN(n)) return '—';
  const sym=CURRENCY_SYMBOLS[currency]||(currency+' ');
  return sym+Math.abs(n).toFixed(3);
}
function fmtPct(n){
  if(n==null||isNaN(n)||!isFinite(n)) return '—';
  return (n>=0?'+':'')+n.toFixed(2)+'%';
}
function fmtShares(n){ return n==null?'—':Math.abs(n).toFixed(6).replace(/\.?0+$/,''); }

function parseDate(s){
  if(!s) return null;
  s=s.trim().replace(/['"]/g,'');
  let m,d;
  // YYYY-MM-DD or YYYY/MM/DD — anchored
  if((m=s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})$/))) d=new Date(+m[1],+m[2]-1,+m[3]);
  // DD/MM/YYYY or DD-MM-YYYY
  else if((m=s.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{4})$/))) d=new Date(+m[3],+m[2]-1,+m[1]);
  // DD Mon YYYY
  else if((m=s.match(/^(\d{1,2})\s+([A-Za-z]{3})\s+(\d{4})$/))){
    const mo={jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11}[m[2].toLowerCase()];
    if(mo!=null) d=new Date(+m[3],mo,+m[1]);
  }
  // Mon DD YYYY
  else if((m=s.match(/^([A-Za-z]{3})\s+(\d{1,2})\s+(\d{4})$/))){
    const mo={jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11}[m[1].toLowerCase()];
    if(mo!=null) d=new Date(+m[3],mo,+m[2]);
  }
  if(!d) return null;
  const yr=d.getFullYear();
  return (yr>=1990 && yr<=new Date().getFullYear()+2) ? d : null;
}

function getTickerCurrency(ticker){
