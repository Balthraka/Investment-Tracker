  const liveTxt=livePrice?'live ✓':'hardcoded data';
  const periodLabel=APP.filters.period==='ALL'?'all time'
    :APP.filters.period==='CUSTOM'?(APP.filters.customStart&&APP.filters.customEnd
      ?APP.filters.customStart.toLocaleDateString('en-AU',{month:'short',year:'numeric'})+' – '+APP.filters.customEnd.toLocaleDateString('en-AU',{month:'short',year:'numeric'})
      :'custom range')
    :APP.filters.period;
  const earlyWarning=APP.transactions.length>0&&new Date(Math.min(...APP.transactions.map(t=>t.date.getTime())))<new Date('2018-01-01')?' · portfolio pre-dates index data':'';
  const noteTxt=hasData
    ?`All-time portfolio return vs ${bmName} ${periodLabel} (${liveTxt}, price-return only${earlyWarning})`
    :'No index data for this period';
  $('bm-chart-sub').textContent=noteTxt;
  $('chart-benchmark').title=hasData?'Note: index is price-return only (excludes dividends). Portfolio return includes dividends.':'';

  if(!hasData){
    $('bm-no-data').innerHTML='<span style="font-size:24px;">📊</span>No index data available for this period';
    return;
  }

  const vals=[portfolioReturnPct??0,bmReturn];
  const pLabel=portfolioReturnPct!=null?'Your Portfolio (all-time)':'Your Portfolio (n/a)';
  const labels=[pLabel,`${bmName} (${periodLabel})`];
  const ctx=$('chart-benchmark').getContext('2d');
  APP.charts['benchmark']=new Chart(ctx,{
    type:'bar',
    data:{labels,datasets:[{data:vals,backgroundColor:vals.map((v,i)=>i===0&&portfolioReturnPct==null?gc('--border'):v>=0?gc('--gain'):gc('--loss')),borderRadius:4,borderWidth:0}]},
    options:{
      ...baseOpts(),
      plugins:{...baseOpts().plugins,tooltip:{...baseOpts().plugins.tooltip,callbacks:{label:c=>fmtPct(c.raw)}}},
      scales:{...baseOpts().scales,y:{...baseOpts().scales.y,ticks:{...baseOpts().scales.y.ticks,callback:v=>v.toFixed(1)+'%'}}}
    }
  });
}

function renderWinnersLosers(unrealized,allTimeRealized){
  dc('wl');
  const combined={};
  for(const [t,h] of Object.entries(unrealized.byTicker)) combined[t]=(h.unrealizedPL||0)+(allTimeRealized.byTicker[t]||0);
  for(const [t,v] of Object.entries(allTimeRealized.byTicker)) if(!(t in combined)) combined[t]=v;
  const sorted=Object.entries(combined).sort((a,b)=>b[1]-a[1]);
  const top=sorted.slice(0,8);
  const bottom=sorted.slice(-5).filter(b=>!top.find(t=>t[0]===b[0]));
  const show=[...top,...bottom].sort((a,b)=>b[1]-a[1]).slice(0,12);
  const out=APP.settings.outputCurrency,sym=CURRENCY_SYMBOLS[out]||'';
  const ctx=$('chart-wl').getContext('2d');
  APP.charts['wl']=new Chart(ctx,{
    type:'bar',indexAxis:'y',
    data:{
      labels:show.map(([t])=>t.split(':')[1]||t),
      datasets:[{data:show.map(([,v])=>v),backgroundColor:show.map(([,v])=>v>=0?gc('--gain'):gc('--loss')),borderRadius:3,borderWidth:0}]
    },
    options:{
      ...baseOpts(),
      plugins:{...baseOpts().plugins,tooltip:{...baseOpts().plugins.tooltip,callbacks:{label:c=>fmt(c.raw,out)}}},
      scales:{...baseOpts().scales,x:{...baseOpts().scales.x,ticks:{...baseOpts().scales.x.ticks,callback:v=>sym+Math.round(v)}}}
    }
  });
}

function renderDividendChart(divIncome){
  dc('dividends');
  $('div-chart-card').style.display='';
  const months=Object.keys(divIncome.byMonth).sort();
  if(!months.length) return;
  const out=APP.settings.outputCurrency,sym=CURRENCY_SYMBOLS[out]||'';
  const ctx=$('chart-dividends').getContext('2d');
  APP.charts['dividends']=new Chart(ctx,{
    type:'bar',
    data:{labels:months,datasets:[{data:months.map(m=>divIncome.byMonth[m]),backgroundColor:gc('--gain')+'99',borderColor:gc('--gain'),borderWidth:1,borderRadius:3}]},
    options:{
      ...baseOpts(),
      plugins:{...baseOpts().plugins,tooltip:{...baseOpts().plugins.tooltip,callbacks:{label:c=>sym+(c.raw?.toFixed(2)||'')}}},
      scales:{...baseOpts().scales,y:{...baseOpts().scales.y,ticks:{...baseOpts().scales.y.ticks,callback:v=>sym+v}}}
    }
  });
}

// ── Table Renderers ───────────────────────────────────────────────
function renderHoldingsTable(unrealized){
  const out=APP.settings.outputCurrency;
  const hasPr=Object.keys(APP.priceCache).length>0;
  const mvHeader=$('holdings-mv-header');
  if(mvHeader) mvHeader.textContent=hasPr?'Market Value':'Value (at cost)';
  const entries=Object.entries(unrealized.byTicker).sort((a,b)=>b[1].marketValue-a[1].marketValue);
  const tbody=$('holdings-tbody');
  tbody.innerHTML='';
  if(!entries.length){
    tbody.innerHTML='<tr><td colspan="7" style="text-align:center;color:var(--text-3);padding:24px;">No open positions</td></tr>';
    return;
  }
  for(const [ticker,h] of entries){
    const pct=h.costBasis>0?(h.unrealizedPL/h.costBasis)*100:0;
    const srcHtml=h.source==='manual'?'<span class="price-src manual">manual</span>':'<span class="price-src none">no price</span>';
    const tr=document.createElement('tr');
    tr.innerHTML=`
      <td><span class="ticker-badge">${ticker}</span></td>
      <td class="r">${fmtShares(h.shares)}</td>
      <td class="r">${fmtPrice(h.avgCost,h.currency)}</td>
      <td class="r">${h.currentPrice!=null?fmtPrice(h.currentPrice,h.priceCurrency):'—'}${srcHtml}</td>
      <td class="r">${fmt(h.marketValue,out)}</td>
      <td class="${h.currentPrice!=null?(h.unrealizedPL>=0?'gain':'loss'):'muted'}">${h.currentPrice!=null?fmt(h.unrealizedPL,out):'—'}</td>
      <td class="${h.currentPrice!=null?(pct>=0?'gain':'loss'):'muted'}">${h.currentPrice!=null?fmtPct(pct):'—'}</td>
    `;
    tbody.appendChild(tr);
  }
}

function renderTxTable(txs,range,realized){
  const out=APP.settings.outputCurrency;
  const filtered=[...txs].filter(tx=>inRange(tx.date,range)).sort((a,b)=>b.date-a.date);
  $('tx-count-label').textContent=`${filtered.length} transaction${filtered.length!==1?'s':''}`;
  const tbody=$('tx-tbody');
  tbody.innerHTML='';
  if(!filtered.length){
    tbody.innerHTML='<tr><td colspan="8" style="text-align:center;color:var(--text-3);padding:24px;">No transactions in selected period</td></tr>';
    return;
  }
  for(const tx of filtered){
    const total=tx.type==='BUY'?toOut(tx.volume*tx.price+tx.brokerage,tx.currency):toOut(tx.volume*tx.price-tx.brokerage,tx.currency);
    const txPL=realized.byTxId[tx.id];
    const plHtml=tx.type==='SELL'&&txPL!=null
      ?`<span class="${txPL>=0?'gain':'loss'}">${fmt(txPL,out)}</span>`
      :'<span style="color:var(--text-3);">—</span>';
    const tr=document.createElement('tr');
    tr.innerHTML=`
      <td style="font-family:var(--mono);font-size:11px;">${tx.date.toLocaleDateString('en-AU')}</td>
      <td><span class="ticker-badge">${tx.ticker}</span></td>
      <td><span class="type-pill ${tx.type.toLowerCase()}">${tx.type}</span></td>
      <td class="r">${fmtShares(tx.volume)}</td>
      <td class="r">${fmtPrice(tx.price,tx.currency)}</td>
      <td class="r">${fmt(tx.brokerage,tx.currency)}</td>
      <td class="r">${fmt(total,out)}</td>
      <td class="r">${plHtml}</td>
    `;
    tbody.appendChild(tr);
  }
}

// ── UI State ──────────────────────────────────────────────────────
function showDashboard(){$('dashboard').style.display='';$('empty-state').style.display='none';}
function showEmpty(){$('dashboard').style.display='none';$('empty-state').style.display='';}

// ── Settings Modal ────────────────────────────────────────────────
function openSettings(){$('settings-modal').classList.add('open');}
function closeSettings(){$('settings-modal').classList.remove('open');if(APP.transactions.length||APP.dividends.length)rebuildDashboard();}

function toggleDRP(){
  APP.settings.drpInTransactions=!APP.settings.drpInTransactions;
  const on=APP.settings.drpInTransactions;
  $('drp-track').style.background=on?'var(--accent)':'var(--border)';
  $('drp-knob').style.left=on?'21px':'3px';
  saveSettings(); rebuildDashboard();
}
function setCostBasis(elem){
  document.querySelectorAll('#cost-basis-group .radio-opt').forEach(e=>e.classList.remove('selected'));
  elem.classList.add('selected');
  APP.settings.costBasisMethod=elem.dataset.val;
  saveSettings(); rebuildDashboard();
}
function setInputCurrencyMode(elem){
  document.querySelectorAll('#input-currency-mode-group .radio-opt').forEach(e=>e.classList.remove('selected'));
  elem.classList.add('selected');
  APP.settings.inputCurrencyMode=elem.dataset.val;
  $('input-currency-override-row').style.display=elem.dataset.val==='override'?'':'none';
  saveSettings(); updateTransactionCurrencies(); rebuildDashboard();
}

function updateTransactionCurrencies(){
  for(const tx of APP.transactions) tx.currency=getTickerCurrency(tx.ticker);
  for(const dv of APP.dividends) dv.currency=getTickerCurrency(dv.ticker);
  loadManualPrices();
}

// ── Theme ─────────────────────────────────────────────────────────
function toggleTheme(){
  const isDark=document.documentElement.dataset.theme==='dark';
  document.documentElement.dataset.theme=isDark?'light':'dark';
  $('btn-theme').textContent=isDark?'◐ Dark':'☀ Light';
  if(APP.transactions.length||APP.dividends.length) rebuildDashboard();
}

// ── File Upload ───────────────────────────────────────────────────
function handleTxUpload(e){
  const file=e.target.files[0]; if(!file) return;
  const reader=new FileReader();
  reader.onload=ev=>{
    try{
      APP.transactions=parseTransactionsCSV(ev.target.result);
      if(!APP.transactions.length){ showGoButton(); return; }
      $('tx-status').textContent='✓ '+file.name+' · '+APP.transactions.length+' rows';
      $('tx-status').classList.add('show');
      $('tx-clear-btn').classList.add('show');
      showGoButton();
    } catch(err){ showNotice('Error parsing transactions: '+err.message,'error'); }
  };
  reader.readAsText(file);
}
function handleDivUpload(e){
  const file=e.target.files[0]; if(!file) return;
  const reader=new FileReader();
  reader.onload=ev=>{
    try{
      APP.dividends=parseDividendsCSV(ev.target.result);
      $('div-status').textContent='✓ '+file.name+' · '+APP.dividends.length+' rows';
      $('div-status').classList.add('show');
      $('div-clear-btn').classList.add('show');
      showGoButton();
    } catch(err){ showNotice('Error parsing dividends: '+err.message,'error'); }
  };
  reader.readAsText(file);
}
function clearTx(){
  APP.transactions=[];
  $('tx-file-input').value='';
  $('tx-status').textContent=''; $('tx-status').classList.remove('show');
  $('tx-clear-btn').classList.remove('show');
  showGoButton();
  if(!APP.dividends.length) showEmpty(); else rebuildDashboard();
}
function clearDiv(){
  APP.dividends=[];
  $('div-file-input').value='';
  $('div-status').textContent=''; $('div-status').classList.remove('show');
  $('div-clear-btn').classList.remove('show');
  showGoButton();
  $('kpi-div-card').style.display='none';
  $('div-chart-card').style.display='none';
  rebuildDashboard();
}
function showGoButton(){
  $('go-btn-row').style.display=(APP.transactions.length||APP.dividends.length)?'flex':'none';
}

// ── Go ────────────────────────────────────────────────────────────
async function handleGo(){
  if(!APP.transactions.length&&!APP.dividends.length){showNotice('Upload at least one CSV file.','warn');return;}
  loadManualPrices();
  APP.filters.period='ALL';
  $('custom-range').style.display='none';
  rebuildPeriodPills();
  // Fetch rates first so conversions are correct from the start
  const currencies=new Set([...APP.transactions.map(t=>t.currency),...APP.dividends.map(d=>d.currency)]);
  if(currencies.size>1||![...currencies].every(c=>c===APP.settings.outputCurrency)){
    await fetchRates(APP.settings.outputCurrency);
  }
  // Fetch benchmark live price (single call, graceful fail)
  const bmSym=getEffectiveBenchmark();
  fetchBenchmarkLivePrice(bmSym).catch(()=>{}); // fire and forget, render twice
  rebuildDashboard();
}

// ── Init ──────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded',()=>{
  loadSettings();
  applySettingsToUI();
  showEmpty();
  fetchRates(APP.settings.outputCurrency);
});
</script>
