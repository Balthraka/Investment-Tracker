<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Folio — Portfolio Dashboard</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
button{font-family:inherit;cursor:pointer;border:none;background:none;}
input,select,textarea{font-family:inherit;}
:root{
  --bg:#F2F1EC;--surface:#FFFFFF;--surface-alt:#ECEAE3;--border:#DDDBD3;
  --text-1:#0F1623;--text-2:#4A5568;--text-3:#9AA3B0;
  --accent:#1748C8;--accent-bg:#EBF0FF;--accent-h:#1238A8;
  --gain:#047857;--gain-bg:#ECFDF5;--gain-border:#A7F3D0;
  --loss:#B91C1C;--loss-bg:#FEF2F2;--loss-border:#FECACA;
  --warn:#B45309;--warn-bg:#FFFBEB;
  --shadow:0 1px 3px rgba(15,22,35,.07),0 1px 2px rgba(15,22,35,.04);
  --shadow-md:0 4px 12px rgba(15,22,35,.08),0 2px 4px rgba(15,22,35,.04);
  --radius:8px;--radius-sm:4px;--mono:'IBM Plex Mono',monospace;--ui:'Sora',sans-serif;
}
[data-theme="dark"]{
  --bg:#0D1117;--surface:#161B22;--surface-alt:#21262D;--border:#30363D;
  --text-1:#E6EDF3;--text-2:#8B949E;--text-3:#6E7681;
  --accent:#58A6FF;--accent-bg:#1C2A3A;--accent-h:#79B8FF;
  --gain:#3FB950;--gain-bg:#0D2818;--gain-border:#196127;
  --loss:#F85149;--loss-bg:#2D0E0E;--loss-border:#7F1D1D;
  --warn:#E3B341;--warn-bg:#2D2A0E;
  --shadow:0 1px 3px rgba(0,0,0,.4);--shadow-md:0 4px 12px rgba(0,0,0,.5);
}
body{font-family:var(--ui);background:var(--bg);color:var(--text-1);font-size:13px;line-height:1.5;min-height:100vh;}
/* HEADER */
#header{position:sticky;top:0;z-index:100;height:56px;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 24px;gap:12px;box-shadow:var(--shadow);}
.logo{font-size:17px;font-weight:700;letter-spacing:-.5px;}.logo span{color:var(--accent);}
.spacer{flex:1;}
.hbtn{display:flex;align-items:center;gap:6px;padding:6px 12px;border-radius:var(--radius-sm);font-size:12px;font-weight:500;color:var(--text-2);border:1px solid var(--border);background:var(--surface);transition:all .15s;}
.hbtn:hover{background:var(--surface-alt);color:var(--text-1);}
.hbtn.primary{background:var(--accent);color:#fff;border-color:var(--accent);}
.hbtn.primary:hover{background:var(--accent-h);}
/* LAYOUT */
#main{padding:20px 24px;max-width:1400px;margin:0 auto;}
@media(max-width:900px){.chart-grid-2{grid-template-columns:1fr!important;}#kpi-row{grid-template-columns:repeat(2,1fr)!important;}}
@media(max-width:600px){#main{padding:12px;}#header{padding:0 12px;}#kpi-row{grid-template-columns:1fr 1fr!important;}}
/* UPLOAD */
#upload-section{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:24px;margin-bottom:20px;box-shadow:var(--shadow);}
#upload-section h2{font-size:14px;font-weight:600;margin-bottom:4px;}
#upload-section>p{color:var(--text-2);font-size:12px;margin-bottom:18px;}
.upload-row{display:flex;gap:16px;flex-wrap:wrap;}
.upload-card{flex:1;min-width:240px;border:1px solid var(--border);border-radius:var(--radius);padding:20px;}
.upload-card h3{font-size:13px;font-weight:600;margin-bottom:4px;}
.upload-card>p{font-size:11px;color:var(--text-2);margin-bottom:14px;}
.upload-card input[type=file]{display:block;width:100%;font-size:12px;color:var(--text-2);cursor:pointer;padding:7px 10px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface-alt);}
.upload-card input[type=file]::file-selector-button{padding:4px 12px;border:none;border-radius:var(--radius-sm);background:var(--accent);color:#fff;font-size:12px;font-weight:600;cursor:pointer;margin-right:10px;}
.upload-card input[type=file]::file-selector-button:hover{background:var(--accent-h);}
.loaded-status{margin-top:8px;font-size:11px;color:var(--gain);font-family:var(--mono);display:none;}
.loaded-status.show{display:block;}
.upload-hint{margin-top:14px;padding:10px 12px;background:var(--surface-alt);border-radius:var(--radius-sm);font-size:11px;color:var(--text-2);}
.upload-hint code{font-family:var(--mono);background:var(--border);padding:1px 5px;border-radius:3px;font-size:10px;}
#go-btn-row{display:none;margin-top:16px;align-items:center;gap:12px;}
#go-btn-row small{font-size:11px;color:var(--text-3);}
/* FORMAT GUIDE */
.fmt-guide{margin-top:18px;}
.fmt-guide-lbl{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--text-3);margin-bottom:10px;}
.fmt-tables{display:flex;gap:16px;flex-wrap:wrap;}
.fmt-card{flex:1;min-width:260px;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;}
.fmt-card-head{padding:10px 14px;background:var(--surface-alt);border-bottom:1px solid var(--border);font-size:12px;font-weight:600;}
.fmt-card-body{padding:12px 14px;}
.fmt-card-body table{width:100%;border-collapse:collapse;font-size:11px;}
.fmt-card-body th{text-align:left;padding:4px 8px;font-weight:600;color:var(--text-2);border-bottom:1px solid var(--border);background:var(--surface-alt);}
.fmt-card-body td{padding:5px 8px;border-bottom:1px solid var(--border);}
.fmt-card-body tr:last-child td{border-bottom:none;}
.fmt-card-body td.ex{font-family:var(--mono);color:var(--accent);}
.fmt-card-body td.lbl{font-weight:600;}
.fmt-card-body td.dim{color:var(--text-2);}
.fmt-note{margin-top:10px;padding:8px 10px;background:var(--surface-alt);border-radius:var(--radius-sm);font-size:11px;color:var(--text-2);line-height:1.6;}
.opt-row{background:var(--accent-bg);}
.example-block{margin-top:12px;padding:12px 14px;background:var(--surface-alt);border-radius:var(--radius);}
.example-block .elbl{font-size:11px;font-weight:600;color:var(--text-2);margin-bottom:6px;}
.example-block pre{font-family:var(--mono);font-size:10px;line-height:1.8;overflow-x:auto;white-space:pre;color:var(--text-1);}
.example-block .enote{font-size:11px;color:var(--text-3);margin-top:6px;}
/* FILTER BAR */
#filter-bar{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:12px 16px;margin-bottom:20px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;box-shadow:var(--shadow);}
.filter-group{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.filter-label{font-size:11px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.5px;white-space:nowrap;}
.period-pills{display:flex;flex-wrap:wrap;gap:4px;}
.pill{padding:4px 10px;border-radius:20px;font-size:11px;font-weight:500;border:1px solid var(--border);color:var(--text-2);cursor:pointer;transition:all .15s;background:var(--surface);}
.pill:hover{border-color:var(--accent);color:var(--accent);}
.pill.active{background:var(--accent);color:#fff;border-color:var(--accent);}
.custom-range{display:flex;gap:8px;align-items:center;}
.custom-range input[type=date]{padding:5px 8px;border-radius:var(--radius-sm);border:1px solid var(--border);background:var(--surface);color:var(--text-1);font-size:11px;}
/* KPI */
#kpi-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:20px;}
.kpi{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px;box-shadow:var(--shadow);position:relative;overflow:hidden;}
.kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--border);}
.kpi.gain::before{background:var(--gain);}
.kpi.loss::before{background:var(--loss);}
.kpi.accent::before{background:var(--accent);}
.kpi-label{font-size:11px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;}
.kpi-value{font-family:var(--mono);font-size:22px;font-weight:500;color:var(--text-1);line-height:1.2;}
.kpi-value.gain{color:var(--gain);}.kpi-value.loss{color:var(--loss);}
.kpi-sub{font-size:11px;color:var(--text-3);margin-top:4px;font-family:var(--mono);}
.kpi-sub.gain{color:var(--gain);}.kpi-sub.loss{color:var(--loss);}
/* CHARTS */
.chart-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;}
.chart-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);}
.chart-card h3{font-size:13px;font-weight:600;margin-bottom:4px;}
.chart-sub{font-size:11px;color:var(--text-3);margin-bottom:16px;}
.chart-wrap{position:relative;width:100%;}
.no-data-msg{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;font-size:12px;color:var(--text-3);gap:8px;text-align:center;}
/* TABLES */
.tbl-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);margin-bottom:20px;overflow:hidden;}
.tbl-head{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;}
.tbl-head h3{font-size:13px;font-weight:600;}
.tbl-head .spacer{flex:1;}
.tbl-head span{font-size:11px;color:var(--text-3);}
.tbl-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;}
th{padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.4px;border-bottom:1px solid var(--border);white-space:nowrap;background:var(--surface);}
th.r{text-align:right;}
td{padding:10px 14px;border-bottom:1px solid var(--border);color:var(--text-1);font-size:12px;vertical-align:middle;}
td.r{text-align:right;font-family:var(--mono);}
td.gain{color:var(--gain);font-family:var(--mono);text-align:right;}
td.loss{color:var(--loss);font-family:var(--mono);text-align:right;}
td.muted{color:var(--text-2);font-family:var(--mono);text-align:right;}
tr:hover td{background:var(--surface-alt);}
tr:last-child td{border-bottom:none;}
.ticker-badge{display:inline-block;font-family:var(--mono);font-size:11px;font-weight:500;padding:2px 7px;border-radius:var(--radius-sm);background:var(--accent-bg);color:var(--accent);}
.type-pill{display:inline-flex;align-items:center;font-size:10px;padding:2px 8px;border-radius:20px;font-weight:600;}
.type-pill.buy{background:var(--gain-bg);color:var(--gain);}
.type-pill.sell{background:var(--loss-bg);color:var(--loss);}
.price-src{font-size:9px;padding:1px 5px;border-radius:2px;margin-left:4px;font-weight:500;vertical-align:middle;}
.price-src.manual{background:var(--accent-bg);color:var(--accent);}
.price-src.none{background:var(--surface-alt);color:var(--text-3);}
/* MODAL */
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;display:none;align-items:center;justify-content:center;}
.modal-backdrop.open{display:flex;}
.modal{background:var(--surface);border-radius:var(--radius);padding:28px;width:540px;max-width:calc(100vw - 32px);box-shadow:var(--shadow-md);position:relative;max-height:calc(100vh - 60px);overflow-y:auto;}
.modal h2{font-size:16px;font-weight:700;margin-bottom:20px;}
.modal-close{position:absolute;top:16px;right:16px;font-size:20px;color:var(--text-3);cursor:pointer;line-height:1;}
.modal-close:hover{color:var(--text-1);}
.form-row{margin-bottom:16px;}
.form-row label{display:block;font-size:12px;font-weight:600;color:var(--text-2);margin-bottom:6px;}
.form-row select,.form-row input[type=text],.form-row input[type=number]{width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface);color:var(--text-1);font-size:13px;}
.form-row select:focus,.form-row input:focus{outline:none;border-color:var(--accent);}
.form-note{font-size:11px;color:var(--text-3);margin-top:5px;line-height:1.5;}
.radio-group{display:flex;gap:8px;flex-wrap:wrap;}
.radio-opt{flex:1;min-width:80px;border:1.5px solid var(--border);border-radius:var(--radius-sm);padding:8px 12px;cursor:pointer;text-align:center;font-size:12px;font-weight:500;color:var(--text-2);transition:all .15s;}
.radio-opt:hover{border-color:var(--accent);color:var(--accent);}
.radio-opt.selected{border-color:var(--accent);background:var(--accent-bg);color:var(--accent);}
.section-div{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--text-3);padding:14px 0 8px;border-top:1px solid var(--border);margin-top:4px;}
.section-div.first{border-top:none;padding-top:0;}
.toggle-row{display:flex;align-items:center;gap:10px;padding:8px 0;}
.modal-actions{display:flex;justify-content:flex-end;margin-top:20px;padding-top:16px;border-top:1px solid var(--border);}
.btn{padding:8px 18px;border-radius:var(--radius-sm);font-size:13px;font-weight:600;cursor:pointer;border:1px solid var(--border);background:var(--surface);color:var(--text-1);transition:all .15s;}
.btn:hover{background:var(--surface-alt);}
.btn.primary{background:var(--accent);color:#fff;border-color:var(--accent);}
.btn.primary:hover{background:var(--accent-h);}
/* NOTICE */
#notice{display:none;margin-bottom:16px;padding:10px 14px;border-radius:var(--radius-sm);font-size:12px;border-left:3px solid;}
#notice.info{background:var(--accent-bg);border-color:var(--accent);color:var(--accent);}
#notice.warn{background:var(--warn-bg);border-color:var(--warn);color:var(--warn);}
#notice.error{background:var(--loss-bg);border-color:var(--loss);color:var(--loss);}
/* EMPTY */
#empty-state{text-align:center;padding:60px 20px;}
#empty-state .ei{font-size:48px;margin-bottom:16px;}
#empty-state h2{font-size:20px;font-weight:600;margin-bottom:8px;}
#empty-state p{color:var(--text-2);max-width:400px;margin:0 auto;}
/* MISC */
.rate-badge{display:inline-block;font-size:10px;padding:2px 6px;border-radius:var(--radius-sm);font-family:var(--mono);margin-left:6px;font-weight:500;}
.rate-ok{background:var(--gain-bg);color:var(--gain);}
.rate-err{background:var(--warn-bg);color:var(--warn);}
.filter-sep{width:1px;height:20px;background:var(--border);flex-shrink:0;}
.clear-file{margin-top:6px;font-size:11px;color:var(--text-3);cursor:pointer;background:none;border:none;padding:0;display:none;text-decoration:underline;}
.clear-file.show{display:inline-block;}
.clear-file:hover{color:var(--loss);}
</style>
</head>
<body>

<div id="header">
  <div class="logo">folio<span>.</span></div>
  <div class="spacer"></div>
  <span id="rate-badge"></span>
  <button class="hbtn" onclick="openSettings()">⚙ Settings</button>
  <button class="hbtn" id="btn-theme" onclick="toggleTheme()">◐ Dark</button>
</div>

<!-- SETTINGS MODAL -->
<div class="modal-backdrop" id="settings-modal">
  <div class="modal">
    <span class="modal-close" onclick="closeSettings()">✕</span>
    <h2>Settings</h2>

    <div class="section-div first">Cost &amp; Calculation</div>

    <div class="form-row">
      <label>Cost Basis Method</label>
      <div class="radio-group" id="cost-basis-group">
        <div class="radio-opt selected" data-val="FIFO" onclick="setCostBasis(this)">FIFO</div>
        <div class="radio-opt" data-val="LIFO" onclick="setCostBasis(this)">LIFO</div>
        <div class="radio-opt" data-val="AVG" onclick="setCostBasis(this)">Average Cost</div>
      </div>
      <p class="form-note">FIFO = first bought first sold · LIFO = last bought first sold · Average = blended cost per share</p>
    </div>

    <div class="toggle-row">
      <span style="flex:1;font-size:12px;font-weight:500;">DRP shares already in transactions CSV</span>
      <div style="flex-shrink:0;width:40px;">
        <div onclick="toggleDRP()" id="drp-track" style="position:relative;width:40px;height:22px;background:var(--accent);border-radius:20px;cursor:pointer;transition:background .2s;">
          <div id="drp-knob" style="position:absolute;width:16px;height:16px;background:#fff;border-radius:50%;top:3px;left:21px;transition:left .2s;box-shadow:0 1px 3px rgba(0,0,0,.25);"></div>
        </div>
      </div>
    </div>
    <p class="form-note" style="margin-bottom:4px;">If ON, reinvested dividends are already in your transactions CSV — avoids double-counting.</p>

    <div class="section-div">Currency</div>

    <div class="form-row">
      <label>Output Currency</label>
      <select id="output-currency-sel" onchange="onOutputCurrencyChange(this.value)">
        <option value="AUD">AUD — Australian Dollar</option>
        <option value="USD">USD — US Dollar</option>
        <option value="GBP">GBP — British Pound</option>
        <option value="EUR">EUR — Euro</option>
        <option value="CAD">CAD — Canadian Dollar</option>
        <option value="NZD">NZD — New Zealand Dollar</option>
        <option value="JPY">JPY — Japanese Yen</option>
        <option value="HKD">HKD — Hong Kong Dollar</option>
        <option value="SGD">SGD — Singapore Dollar</option>
      </select>
      <p class="form-note">Exchange rates fetched automatically from exchangerate-api.com — free, no key needed.</p>
    </div>

    <div class="form-row">
      <label>Input Currency Detection</label>
      <div class="radio-group" id="input-currency-mode-group">
        <div class="radio-opt selected" data-val="auto" onclick="setInputCurrencyMode(this)">Auto-detect by exchange</div>
        <div class="radio-opt" data-val="override" onclick="setInputCurrencyMode(this)">Override — all one currency</div>
      </div>
    </div>
    <div class="form-row" id="input-currency-override-row" style="display:none;">
      <label>Force All Input Currency To</label>
      <select id="input-currency-override-sel" onchange="APP.settings.inputCurrencyOverride=this.value;saveSettings();updateTransactionCurrencies();rebuildDashboard();">
        <option value="AUD">AUD</option><option value="USD">USD</option><option value="GBP">GBP</option>
        <option value="EUR">EUR</option><option value="CAD">CAD</option><option value="NZD">NZD</option>
        <option value="SGD">SGD</option><option value="HKD">HKD</option><option value="JPY">JPY</option>
      </select>
    </div>

    <div class="section-div">Financial Year</div>

    <div class="form-row">
      <label>Financial Year Definition</label>
      <select id="fy-country-sel" onchange="APP.settings.fyCountry=this.value;saveSettings();rebuildPeriodPills();rebuildDashboard();">
        <option value="AU">Australia — 1 Jul to 30 Jun</option>
        <option value="UK">United Kingdom — 6 Apr to 5 Apr</option>
        <option value="US">United States — use CY pills instead of FY for Jan–Dec</option>
      </select>
    </div>

    <div class="modal-actions">
      <button class="btn primary" onclick="closeSettings()">Done</button>
    </div>
  </div>
</div>

<div id="main">
  <div id="notice"></div>

  <!-- Upload -->
  <div id="upload-section">
    <h2>Import Data</h2>
    <p>Upload your CSV files below. Each is optional — the dashboard adapts to what you provide. No data leaves your browser.</p>
    <div class="upload-row">
      <div class="upload-card">
        <h3>📊 Transactions</h3>
        <p>Date · Ticker · Volume · Price · Brokerage · Current Price (optional)</p>
        <input type="file" accept=".csv" id="tx-file-input" onchange="handleTxUpload(event)">
        <div class="loaded-status" id="tx-status"></div>
        <button class="clear-file" id="tx-clear-btn" onclick="clearTx()">✕ Remove file</button>
      </div>
      <div class="upload-card">
        <h3>💰 Dividends</h3>
        <p>Date · Ticker · Total Amount · Reinvested (Yes/No)</p>
        <input type="file" accept=".csv" id="div-file-input" onchange="handleDivUpload(event)">
        <div class="loaded-status" id="div-status"></div>
        <button class="clear-file" id="div-clear-btn" onclick="clearDiv()">✕ Remove file</button>
      </div>
    </div>
    <div id="go-btn-row">
      <button class="btn primary" style="padding:10px 28px;font-size:14px;" onclick="handleGo()">Load Dashboard →</button>
      <small>You can upload the second file first if needed</small>
    </div>
    <div class="upload-hint" style="margin-top:14px;">
      <strong>Ticker format:</strong> <code>ASX:TLS</code> <code>NYSE:AAPL</code> <code>NASDAQ:MSFT</code> <code>LSE:SHEL</code>
      &nbsp;|&nbsp; <strong>Sells:</strong> negative volume e.g. <code>-100</code>
      &nbsp;|&nbsp; <strong>Dates:</strong> <code>YYYY-MM-DD</code> or <code>DD/MM/YYYY</code>
    </div>
    <!-- Format guide -->
    <div class="fmt-guide">
      <div class="fmt-guide-lbl">CSV Format Reference</div>
      <div class="fmt-tables">
        <div class="fmt-card">
          <div class="fmt-card-head">📊 Transactions — 5 required columns + 1 optional</div>
          <div class="fmt-card-body">
            <table>
              <thead><tr><th>Column</th><th>Format</th><th>Example</th></tr></thead>
              <tbody>
                <tr><td class="lbl">Date</td><td class="dim">YYYY-MM-DD or DD/MM/YYYY</td><td class="ex">2024-03-15</td></tr>
