// ── Calculations ──────────────────────────────────────────────────
function getDateRange(){
  const p=APP.filters.period,fy=APP.settings.fyCountry;
  const now=new Date(),y=now.getFullYear(),m=now.getMonth();
  if(p==='ALL') return {start:null,end:null};
  if(p==='YTD') return {start:new Date(y,0,1),end:now};
  if(p==='1Y')  return {start:new Date(y-1,m,now.getDate()),end:now};
  if(p.startsWith('CY')){ const cy=parseInt(p.slice(2)); return {start:new Date(cy,0,1),end:new Date(cy,11,31,23,59,59)}; }
  if(p.startsWith('FY')){ const fy2=parseInt(p.slice(2));
    if(fy==='AU') return {start:new Date(fy2-1,6,1),end:new Date(fy2,5,30,23,59,59)};
    if(fy==='UK') return {start:new Date(fy2-1,3,6),end:new Date(fy2,3,5,23,59,59)};
    return {start:new Date(fy2,0,1),end:new Date(fy2,11,31,23,59,59)};
  }
  if(p==='CUSTOM') return {start:APP.filters.customStart,end:APP.filters.customEnd};
  return {start:null,end:null};
}

function inRange(date,range){
  if(!range||(!range.start&&!range.end)) return true;
  if(range.start&&date<range.start) return false;
  if(range.end&&date>range.end) return false;
  return true;
}

function buildLots(transactions,method,endDate){
  const lots={};
  for(const tx of [...transactions].sort((a,b)=>a.date-b.date)){
    if(endDate&&tx.date>endDate) continue;
    const t=tx.ticker;
    if(!lots[t]) lots[t]=[];
    if(tx.type==='BUY'){
      lots[t].push({shares:tx.volume,costPerShare:tx.price+(tx.brokerage/tx.volume),date:tx.date,currency:tx.currency});
    } else {
      let rem=tx.volume;
      if(method==='FIFO'){
        while(rem>1e-8&&lots[t].length){const l=lots[t][0];const s=Math.min(rem,l.shares);rem-=s;l.shares-=s;if(l.shares<1e-8)lots[t].shift();}
      } else if(method==='LIFO'){
        while(rem>1e-8&&lots[t].length){const l=lots[t][lots[t].length-1];const s=Math.min(rem,l.shares);rem-=s;l.shares-=s;if(l.shares<1e-8)lots[t].pop();}
      } else {
        const tot=lots[t].reduce((s,l)=>s+l.shares,0);
        const cost=lots[t].reduce((s,l)=>s+l.shares*l.costPerShare,0);
        const avg=tot>0?cost/tot:0;
        const remain=Math.max(0,tot-tx.volume);
        lots[t]=remain>0?[{shares:remain,costPerShare:avg,date:tx.date,currency:tx.currency}]:[];
      }
    }
  }
  for(const t of Object.keys(lots)) lots[t]=lots[t].filter(l=>l.shares>1e-8);
  return lots;
}

function computeRealizedPL(transactions,method,range){
  const sorted=[...transactions].sort((a,b)=>a.date-b.date);
  const lots={},byTicker={},byTxId={};
  let total=0;
  for(const tx of sorted){
    const t=tx.ticker;
    if(!lots[t]) lots[t]=[];
    if(tx.type==='BUY'){
      lots[t].push({shares:tx.volume,costPerShare:tx.price+(tx.brokerage/tx.volume),currency:tx.currency});
    } else {
      const inR=inRange(tx.date,range);
      let rem=tx.volume,gl=0;
      if(method==='FIFO'){
        while(rem>1e-8&&lots[t].length){const l=lots[t][0];const s=Math.min(rem,l.shares);if(inR)gl+=s*(tx.price-l.costPerShare);rem-=s;l.shares-=s;if(l.shares<1e-8)lots[t].shift();}
      } else if(method==='LIFO'){
        while(rem>1e-8&&lots[t].length){const l=lots[t][lots[t].length-1];const s=Math.min(rem,l.shares);if(inR)gl+=s*(tx.price-l.costPerShare);rem-=s;l.shares-=s;if(l.shares<1e-8)lots[t].pop();}
      } else {
        const tot=lots[t].reduce((s,l)=>s+l.shares,0);
        const cost=lots[t].reduce((s,l)=>s+l.shares*l.costPerShare,0);
        const avg=tot>0?cost/tot:0;
        if(inR) gl=tx.volume*(tx.price-avg);
        const remain=Math.max(0,tot-tx.volume);
        lots[t]=remain>0?[{shares:remain,costPerShare:avg,currency:tx.currency}]:[];
      }
      if(inR){
        gl-=tx.brokerage;
        const cv=toOut(gl,tx.currency);
        byTicker[t]=(byTicker[t]||0)+cv;
        byTxId[tx.id]=cv;
        total+=cv;
      }
    }
  }
  return {byTicker,byTxId,total};
}

function computeUnrealizedPL(lots){
  let totalValue=0,totalCost=0;
  const byTicker={};
  for(const [ticker,lotArr] of Object.entries(lots)){
    if(!lotArr.length) continue;
    const tx=APP.transactions.find(t=>t.ticker===ticker);
    if(!tx) continue;
    const cached=APP.priceCache[ticker];
    const currentPrice=cached?.price??null;
    const priceCurrency=cached?.currency||tx.currency;
    const totalShares=lotArr.reduce((s,l)=>s+l.shares,0);
    const totalCostBasis=lotArr.reduce((s,l)=>s+l.shares*l.costPerShare,0);
    const costConv=toOut(totalCostBasis,tx.currency);
    const valueConv=currentPrice!=null?toOut(totalShares*currentPrice,priceCurrency):costConv;
    byTicker[ticker]={shares:totalShares,avgCost:totalCostBasis/totalShares,currentPrice,priceCurrency,
      unrealizedPL:valueConv-costConv,marketValue:valueConv,costBasis:costConv,currency:tx.currency,source:cached?.source};
    totalValue+=valueConv; totalCost+=costConv;
  }
  return {byTicker,totalValue,totalCost,totalUnrealized:totalValue-totalCost};
}

function computeNetInvestedOverTime(transactions){
  const sorted=[...transactions].sort((a,b)=>a.date-b.date);
  const months={};
  for(const tx of sorted){
    const key=`${tx.date.getFullYear()}-${String(tx.date.getMonth()+1).padStart(2,'0')}`;
    if(!months[key]) months[key]=0;
    const cost=tx.volume*tx.price+tx.brokerage;
    months[key]+=tx.type==='BUY'?toOut(cost,tx.currency):-toOut(tx.volume*tx.price-tx.brokerage,tx.currency);
  }
  let cumul=0;
  return Object.keys(months).sort().map(k=>{cumul+=months[k];return{label:k,value:cumul};});
}

function computeDividendIncome(dividends,range){
  const effective=APP.settings.drpInTransactions?dividends.filter(d=>!d.reinvested):dividends;
  let total=0; const byMonth={};
  for(const d of effective){
    if(!inRange(d.date,range)) continue;
    const amt=toOut(d.amount,d.currency);
    total+=amt;
    const key=`${d.date.getFullYear()}-${String(d.date.getMonth()+1).padStart(2,'0')}`;
    byMonth[key]=(byMonth[key]||0)+amt;
  }
  return {total,byMonth};
}

// ── Period Pills ──────────────────────────────────────────────────
function fyLabel(year,country){
  if(country==='AU'||country==='UK') return `FY${String(year-1).slice(2)}/${String(year).slice(2)}`;
  return `FY${year}`;
}

function rebuildPeriodPills(){
  const allDates=[...APP.transactions.map(t=>t.date),...APP.dividends.map(d=>d.date)].filter(Boolean);
  if(!allDates.length) return;
  const minDate=allDates.reduce((a,b)=>a<b?a:b);
  const minYear=Math.max(minDate.getFullYear(),1990);
  const maxYear=new Date().getFullYear();
  const fy=APP.settings.fyCountry;

  const periods=[{val:'ALL',label:'All'},{val:'YTD',label:'YTD'},{val:'1Y',label:'1Y'}];
  for(let y=maxYear;y>=minYear;y--) periods.push({val:`CY${y}`,label:`CY${y}`});
  if(fy!=='US') for(let y=maxYear;y>=minYear;y--) periods.push({val:`FY${y}`,label:fyLabel(y,fy)});
  periods.push({val:'CUSTOM',label:'Custom…'});

  const container=$('period-pills');
  container.innerHTML='';
  for(const p of periods){
    const el=document.createElement('div');
    el.className='pill'+(APP.filters.period===p.val?' active':'');
    el.textContent=p.label;
    el.onclick=()=>setPeriod(p.val);
    container.appendChild(el);
  }
}

function setPeriod(val){
  APP.filters.period=val;
  $('custom-range').style.display=val==='CUSTOM'?'flex':'none';
  rebuildPeriodPills();
  if(val!=='CUSTOM'){
    rebuildDashboard(); // immediate with cached/hardcoded data
    // If period ends today, try to fetch live benchmark price
    const range=getDateRange();
    if(periodEndsToday(range)){
      const sym=getEffectiveBenchmark();
      if(!APP.benchmarkCache[sym]){
        fetchBenchmarkLivePrice(sym).then(p=>{if(p!=null)rebuildDashboard();}).catch(()=>{});
      }
    }
  }
}

function applyCustomRange(){
  const s=$('custom-start').value, e=$('custom-end').value;
  APP.filters.customStart=s?new Date(s+'T00:00:00'):null;
  APP.filters.customEnd=e?new Date(e+'T23:59:59'):null;
  rebuildDashboard();
  // Fetch live benchmark if custom range ends today or in future
  const range=getDateRange();
  if(periodEndsToday(range)){
    const sym=getEffectiveBenchmark();
    if(!APP.benchmarkCache[sym]){
      fetchBenchmarkLivePrice(sym).then(p=>{if(p!=null)rebuildDashboard();}).catch(()=>{});
    }
  }
}

// ── Net Deployed ──────────────────────────────────────────────────
function computeNetDeployed(){
  // Total cash in minus total proceeds out — all time
  let deployed=0;
  for(const tx of APP.transactions){
    const cost=tx.volume*tx.price+tx.brokerage;
    deployed+=tx.type==='BUY'?toOut(cost,tx.currency):-toOut(tx.volume*tx.price-tx.brokerage,tx.currency);
  }
  return deployed;
}

function hasMixedCurrencies(){
  const cur=new Set(APP.transactions.map(t=>t.currency));
  return cur.size>1;
}

// ── Benchmark Helpers ────────────────────────────────────────────
function getEffectiveBenchmark(){
  const sel=APP.filters.benchmark;
  if(sel!=='auto') return sel;
  // Auto: dominant currency in portfolio
  const counts={};
  for(const tx of APP.transactions) counts[tx.currency]=(counts[tx.currency]||0)+tx.volume*tx.price;
  const dom=Object.entries(counts).sort((a,b)=>b[1]-a[1])[0]?.[0];
  if(dom==='AUD') return '^AXJO';
  if(dom==='GBP') return '^FTSE';
  return '^GSPC';
}

function findNearestPrice(symbol, date){
  const data=BM_PRICES[symbol]; if(!data) return null;
  const ts=date.getTime();
  let best=null, bestDiff=Infinity;
  for(const [d,v] of Object.entries(data)){
    const diff=Math.abs(new Date(d).getTime()-ts);
    if(diff<bestDiff){bestDiff=diff;best=v;}
  }
  // Reject if nearest point is >180 days away — data too stale to be meaningful
  const MAX_STALE_MS=180*24*60*60*1000;
  return bestDiff<MAX_STALE_MS?best:null;
}

function periodEndsToday(range){
  if(!range||!range.end) return true; // ALL
  return range.end>=new Date();
}

function calcBenchmarkReturn(symbol, range, livePrice){
  const data=BM_PRICES[symbol]; if(!data) return null;
  const now=new Date();
  // Start price
  const txDates=APP.transactions.map(t=>t.date.getTime());
  const startDate=range.start||(txDates.length?new Date(Math.min(...txDates)):new Date());
  const startPrice=findNearestPrice(symbol,startDate);
  if(!startPrice) return null;
  // End price: live if period ends today/future, else hardcoded
  let endPrice;
  if(periodEndsToday(range)){
    endPrice=livePrice??findNearestPrice(symbol,now);
  } else {
    endPrice=findNearestPrice(symbol,range.end);
  }
  if(!endPrice) return null;
  return (endPrice-startPrice)/startPrice*100;
}

// Single live price fetch for benchmark — one call, two proxies, graceful fail
async function fetchBenchmarkLivePrice(symbol){
  const cache=APP.benchmarkCache[symbol];
  if(cache&&Date.now()-cache.ts<3600000) return cache.price; // 1h cache
  const yUrl=`https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(symbol)}?range=1d&interval=1d`;
  const proxies=[
    u=>`https://corsproxy.io/?url=${encodeURIComponent(u)}`,
    u=>`https://api.allorigins.win/get?url=${encodeURIComponent(u)}`,
  ];
  for(const proxy of proxies){
    try{
      const resp=await Promise.race([
        fetch(proxy(yUrl)),
        new Promise((_,r)=>setTimeout(()=>r(new Error('timeout')),6000)),
      ]);
      if(!resp.ok) continue;
      const text=await resp.text();
      const json=JSON.parse(text);
      const data=json.contents?JSON.parse(json.contents):json;
      const price=data?.chart?.result?.[0]?.meta?.regularMarketPrice;
      if(price){APP.benchmarkCache[symbol]={price,ts:Date.now()};return price;}
    }catch(e){continue;}
  }
  return null; // graceful fail — will use hardcoded nearest
}

function onBenchmarkChange(val){
  APP.filters.benchmark=val;
  APP.settings.selectedBenchmark=val;
  saveSettings(); // persist selection
  const sym=getEffectiveBenchmark();
  rebuildDashboard(); // immediate with cached/hardcoded data
  // Also fetch live price if needed and update again
  if(periodEndsToday(getDateRange())&&!APP.benchmarkCache[sym]){
    fetchBenchmarkLivePrice(sym).then(p=>{if(p!=null)rebuildDashboard();}).catch(()=>{});
  }
}

// ── Dashboard Rebuild ─────────────────────────────────────────────
function rebuildDashboard(){
  const txs=APP.transactions,divs=APP.dividends;
  if(!txs.length&&!divs.length){showEmpty();return;}
  showDashboard();
  const range=getDateRange(),out=APP.settings.outputCurrency,method=APP.settings.costBasisMethod;

  const lots=buildLots(txs,method,null);
  const unrealized=computeUnrealizedPL(lots);
  const realized=computeRealizedPL(txs,method,range);
  const divIncome=computeDividendIncome(divs,range);

  const netDeployed=computeNetDeployed();
  const portfolioValue=unrealized.totalValue;
  const costBasis=unrealized.totalCost;
  const totalReturn=unrealized.totalUnrealized+realized.total+divIncome.total;
  const totalReturnPct=netDeployed>0?(totalReturn/netDeployed)*100:null;

  // Warn if mixed currencies and rates unavailable
  if(hasMixedCurrencies()&&Object.keys(APP.rateCache).length===0&&APP.transactions.length){
    showNotice('Mixed currencies detected but exchange rates unavailable — figures may be inaccurate.','warn');
  }

  const priceCount=Object.keys(APP.priceCache).length;
  const hasPrices=priceCount>0;
  $('kpi-value').textContent=fmt(portfolioValue,out);
  $('kpi-value').className='kpi-value'+(hasPrices?'':' muted');
  const openCount=Object.keys(unrealized.byTicker).length;
  $('kpi-holdings-count').textContent=openCount+' positions'+(priceCount>0?` · ${priceCount} priced`:' · at cost — add prices');

  $('kpi-invested').textContent=fmt(netDeployed,out);
  $('kpi-invested-sub').textContent='Net cash deployed (buys − proceeds)';

  const ur=unrealized.totalUnrealized;
  const hasPricesKPI=hasPrices;
  if(hasPricesKPI){
    setKPI('kpi-unrealized','kpi-unrealized-pct','kpi-unreal-card',ur,costBasis>0?(ur/costBasis)*100:0,out);
  } else {
    $('kpi-unrealized').textContent='—'; $('kpi-unrealized').className='kpi-value';
    $('kpi-unrealized-pct').textContent='no prices loaded'; $('kpi-unrealized-pct').className='kpi-sub';
    $('kpi-unreal-card').className='kpi';
  }

  // Realized % shown as absolute only — no meaningful single denominator
  const rl=realized.total;
  $('kpi-realized').textContent=fmt(rl,out);
  $('kpi-realized').className='kpi-value '+(rl>=0?'gain':'loss');
  $('kpi-realized-pct').textContent='period realized';
  $('kpi-realized-pct').className='kpi-sub';
  $('kpi-real-card').className='kpi '+(rl>=0?'gain':'loss');

  $('kpi-total-return').textContent=fmt(totalReturn,out);
  $('kpi-total-return').className='kpi-value '+(totalReturn>=0?'gain':'loss');
  $('kpi-total-return-sub').textContent=totalReturnPct!=null?fmtPct(totalReturnPct):'—';
  $('kpi-total-card').className='kpi '+(totalReturn>=0?'gain':'loss');

  if(divs.length){
    $('kpi-div-card').style.display='';
    $('kpi-dividends').textContent=fmt(divIncome.total,out);
    $('kpi-dividends-sub').textContent='Period income';
  }

  // Compute all-time values separately for benchmark comparison
  const allTimeRealized=APP.filters.period==='ALL'?realized:computeRealizedPL(txs,method,{start:null,end:null});
  const allTimeDivTotal=(APP.settings.drpInTransactions?divs.filter(d=>!d.reinvested):divs).reduce((s,d)=>s+toOut(d.amount,d.currency),0);
  const allTimeReturn=unrealized.totalUnrealized+allTimeRealized.total+allTimeDivTotal;
  const portfolioAllTimeReturnPct=netDeployed>0?(allTimeReturn/netDeployed)*100:null;

  renderCapitalChart(unrealized);
  renderBenchmarkChart(portfolioAllTimeReturnPct);
  renderWinnersLosers(unrealized,allTimeRealized);
  if(divs.length&&Object.keys(divIncome.byMonth).length) renderDividendChart(divIncome); else $('div-chart-card').style.display='none';
  renderHoldingsTable(unrealized);
  renderTxTable(txs,range,realized);
}

