// ── CSV Parsing ───────────────────────────────────────────────────
function parseTransactionsCSV(text){
  let res=Papa.parse(text,{header:true,skipEmptyLines:true,dynamicTyping:false});
  const fk=Object.keys(res.data[0]||{})[0]||'';
  const useHeader=res.data.length>0&&isNaN(fk)&&Object.keys(res.data[0]).length>=4;
  if(!useHeader) res=Papa.parse(text,{header:false,skipEmptyLines:true,dynamicTyping:false});

  const rows=[],issues=[];
  let idx=0;

  for(let ri=0;ri<res.data.length;ri++){
    const raw=res.data[ri];
    const vals=useHeader?Object.values(raw).map(v=>String(v||'').trim()):raw.map(v=>String(v||'').trim());
    if(vals.length<4){issues.push(`Row ${ri+1}: too few columns`);continue;}

    let col=[0,1,2,3,4,5];
    if(useHeader){
      const keys=Object.keys(raw).map(k=>k.toLowerCase().trim());
      const find=(names,def)=>{for(const n of names){const i=keys.findIndex(k=>k.includes(n));if(i>=0)return i;}return def;};
      col[0]=find(['date'],0); col[1]=find(['tick','sym','stock','code'],1);
      col[2]=find(['vol','qty','shares','unit','quant'],2); col[3]=find(['price','px','cost','rate'],3);
      col[4]=find(['brok','fee','comm','charge'],4); col[5]=find(['manual','override','current','live'],5);
    }

    const dateStr=(vals[col[0]]||'');
    const tickerStr=(vals[col[1]]||'').toUpperCase().replace(/\s/g,'');
    const volStr=vals[col[2]]||''; const priceStr=vals[col[3]]||'';
    const brokStr=vals[col[4]]||''; const manualStr=vals[col[5]]||'';

    if(!useHeader&&(dateStr.toLowerCase()==='date'||tickerStr.toLowerCase()==='ticker')) continue;

    const date=parseDate(dateStr);
    const volume=parseFloat(volStr.replace(/[$,\s]/g,''));
    const price=parseFloat(priceStr.replace(/[$,\s]/g,''));
    const brokerage=parseFloat(brokStr.replace(/[$,\s]/g,''))||0;
    const manualPrice=manualStr?parseFloat(manualStr.replace(/[$,\s]/g,'')):null;

    if(!date)        {issues.push(`Row ${ri+1}: can't parse date "${dateStr}"`);continue;}
    if(!tickerStr)   {issues.push(`Row ${ri+1}: missing ticker`);continue;}
    if(isNaN(volume)){issues.push(`Row ${ri+1}: can't parse volume "${volStr}"`);continue;}
    if(isNaN(price)) {issues.push(`Row ${ri+1}: can't parse price "${priceStr}"`);continue;}
    if(volume===0)   {issues.push(`Row ${ri+1}: volume is 0 — skipped`);continue;}

    let exchange,symbol,ticker;
    if(tickerStr.includes(':')){
      [exchange,symbol]=tickerStr.split(':');
      exchange=exchange.toUpperCase(); symbol=symbol.toUpperCase();
      ticker=exchange+':'+symbol;
    } else {
      symbol=tickerStr; exchange='NYSE'; ticker='NYSE:'+symbol;
      issues.push(`Row ${ri+1}: "${tickerStr}" has no exchange prefix — assumed NYSE`);
    }

    rows.push({
      id:idx++, date, ticker, exchange, symbol,
      volume:Math.abs(volume), type:volume<0?'SELL':'BUY',
      price, brokerage,
      manualPrice:(manualPrice&&!isNaN(manualPrice))?manualPrice:null,
      currency:getTickerCurrency(ticker),
    });
  }

  if(rows.length===0){
    showNotice('No valid rows found. Issues: '+issues.slice(0,3).join(' | '),'error');
  } else if(issues.length>0){
    const real=issues.filter(i=>!i.includes('assumed NYSE')).length;
    if(real>0) showNotice(real+' row(s) skipped — first: '+issues[0],'warn');
  }
  console.log('[Folio]',rows.length,'rows,',issues.length,'issues:',issues);
  return rows.sort((a,b)=>a.date-b.date);
}

function parseDividendsCSV(text){
  let res=Papa.parse(text,{header:true,skipEmptyLines:true,dynamicTyping:false});
  const fk=Object.keys(res.data[0]||{})[0]||'';
  const useHeader=res.data.length>0&&isNaN(fk)&&Object.keys(res.data[0]).length>=3;
  if(!useHeader) res=Papa.parse(text,{header:false,skipEmptyLines:true,dynamicTyping:false});

  const rows=[];
  for(let ri=0;ri<res.data.length;ri++){
    const raw=res.data[ri];
    const vals=useHeader?Object.values(raw).map(v=>String(v||'').trim()):raw.map(v=>String(v||'').trim());
    if(vals.length<3) continue;

    let col=[0,1,2,3];
    if(useHeader){
      const keys=Object.keys(raw).map(k=>k.toLowerCase().trim());
      const find=(names,def)=>{for(const n of names){const i=keys.findIndex(k=>k.includes(n));if(i>=0)return i;}return def;};
      col[0]=find(['date'],0); col[1]=find(['tick','sym','stock'],1);
      col[2]=find(['amount','total','div','income'],2); col[3]=find(['reinv'],3);
    }

    const dateStr=vals[col[0]]||'';
    const tickerStr=(vals[col[1]]||'').toUpperCase().replace(/\s/g,'');
    const amtStr=vals[col[2]]||''; const reinvStr=vals[col[3]]||'';
    if(!useHeader&&dateStr.toLowerCase()==='date') continue;

    const date=parseDate(dateStr);
    const amount=parseFloat(amtStr.replace(/[$,\s]/g,''));
    if(!date||!tickerStr||isNaN(amount)) continue;

    const ticker=tickerStr.includes(':')?tickerStr:'NYSE:'+tickerStr;
    rows.push({date,ticker,amount,reinvested:/^yes$/i.test(reinvStr.trim()),currency:getTickerCurrency(ticker)});
  }
  return rows.sort((a,b)=>a.date-b.date);
}

