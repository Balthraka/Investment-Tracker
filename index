  const pos=amount>=0;
  $(valId).textContent=fmt(amount,out);
  $(valId).className='kpi-value '+(pos?'gain':'loss');
  $(subId).textContent=fmtPct(pct);
  $(subId).className='kpi-sub '+(pos?'gain':'loss');
  $(cardId).className='kpi '+(pos?'gain':'loss');
