    if(!r.ok) throw new Error('HTTP '+r.status);
    const data=await r.json();
    for(const [to,rate] of Object.entries(data.rates||{})){
      APP.rateCache[`${base}_${to}`]=rate;
      if(rate) APP.rateCache[`${to}_${base}`]=1/rate;
    }
    $('rate-badge').innerHTML='<span class="rate-badge rate-ok">rates live ✓</span>';
    return true;
  } catch(e){
    $('rate-badge').innerHTML='<span class="rate-badge rate-err">rates unavailable</span>';
    return false;
  }
}

